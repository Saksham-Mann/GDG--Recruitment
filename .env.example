# ==========================================
# 1. LOCAL EMULATOR CONFIGURATION (Optional)
# ==========================================
# Uncomment to use local Firestore emulator instead of production Cloud Firestore:
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# ==========================================
# 2. FIREBASE FIRESTORE CONFIGURATION (Server-Side Only)
# ==========================================
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==========================================
# 3. BETTER-AUTH & SESSION CONFIGURATION
# ==========================================
BETTER_AUTH_SECRET="a_random_32_character_secret_key"
BETTER_AUTH_URL="http://localhost:3000"  # Set to production URL when deployed

# ==========================================
# 4. GOOGLE OAUTH PROVIDER (VIT Email Auth)
# ==========================================
GOOGLE_CLIENT_ID="xxxx-xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"

# ==========================================
# 5. NODEMAILER EMAIL TRANSPORT & OTP VERIFICATION
# ==========================================
# Used for 6-digit OTP email verification and recruitment communications.
# If omitted or unconfigured during local development, the system gracefully degrades
# and logs the verification code directly to the server console: [DEV-OTP] Verification code for ...
EMAIL_USERNAME="your-email@gmail.com"
EMAIL_PASSWORD="your-gmail-app-password"

# ==========================================
# 6. RECRUITMENT CAMPAIGN SETTINGS (Optional)
# ==========================================
RECRUITMENT_DEADLINE="2026-12-31T23:59:59+05:30"
